# Copy this file to .env and fill in real values. Never commit .env.

# Django
DEBUG=True
SECRET_KEY=change-me-generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite by default (development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# PostgreSQL (production) - uncomment and fill in:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=adram_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email (console backend prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@adramtechnologies.com
CONTACT_NOTIFY_EMAIL=adramtechnologies@gmail.com

# CORS - frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DJANGO_LOG_LEVEL=INFO
