# Copy this file to .env and fill in real values. Never commit .env.

# Django
DEBUG=True
SECRET_KEY=change-me-generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: PostgreSQL. move_to_postgres.py creates this database and user and fills these in.
# Use a database user of its own for the site, not the "postgres" superuser.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=adram_db
DB_USER=adram_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# SQLite (a single file, no server needed) instead:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Email (console backend prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@adramtechnologies.com
CONTACT_NOTIFY_EMAIL=adramtechnologies@gmail.com

# CORS - frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DJANGO_LOG_LEVEL=INFO

# Social sign-in. Register this redirect URI with each provider:
#   {BACKEND_URL}/api/v1/auth/oauth/<google|facebook|github>/callback/
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
# Google: https://console.cloud.google.com/apis/credentials  (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps  (Facebook Login; App ID and App Secret)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers  (New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Serve the website from Django (production) ----
# When true, Django also serves the built website (frontend/dist), so link previews on WhatsApp/Facebook/LinkedIn
# use the wording and picture edited in Website > Site content. Run "npm run build" in the frontend folder first.
# Django's own administration site then moves from /admin/ to /django-admin/, and the API docs from / to /swagger/.
SERVE_FRONTEND=false
# FRONTEND_DIST=C:/path/to/frontend/dist

# ---- Security when the site goes live (DEBUG=False) ----
# HTTP is redirected to HTTPS automatically. If HTTPS ends at a proxy (nginx, cPanel, a load balancer), set:
# SECURE_PROXY_SSL_HEADER=true
# Your real address(es), for forms posted over HTTPS:
# CSRF_TRUSTED_ORIGINS=https://adramtechnologies.com,https://www.adramtechnologies.com
# Once HTTPS works everywhere, tell browsers to always use it (1 year). Hard to undo, so turn on last:
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Email codes per person per hour (default: no limit in development, 10 when DEBUG=False; 0 = no limit)
# OTP_MAX_CODES_PER_HOUR=10
# Wrong passwords for one email (from one address) before sign-in pauses, and for how long
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCKOUT_MINUTES=15
# Request limits per network address (see backend/settings.py, API_RATES). API_THROTTLING=false turns them off.
# RATE_ANON=1500/min
# RATE_AUTH=60/min
# RATE_FORMS=30/hour
# API docs (Swagger/ReDoc) are public in development and staff-only in production; true opens them to everyone.
# API_DOCS_PUBLIC=false

# Website assistant (chatbot): a key from https://console.anthropic.com gives full AI answers
ANTHROPIC_API_KEY=
