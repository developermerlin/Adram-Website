# Where the Django API lives. In development the Vite proxy forwards /api, so the default works.
VITE_API_URL=/api
# Used for the link to the Django admin from the admin dashboard.
VITE_BACKEND_URL=http://127.0.0.1:8000
# Public website address used in shared links (Share button on scholarships).
VITE_SITE_URL=https://adramtechnologies.com
